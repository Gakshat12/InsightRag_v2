# Gemini LLM Configuration (used for generator & router)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
LLM_PROVIDER=gemini

# Tavily Web Search API Configuration
TAVILY_API_KEY=your-tavily-api-key-here

# Routing Configuration
# Options: "fan_out" (queries all sources) or "cascade_router" (KB first, then Gemini router)
ROUTING_MODE=cascade_router
CASCADE_KB_THRESHOLD=0.50
LOW_CONFIDENCE_THRESHOLD=0.35

# Local Sentence-Transformers Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# CrossEncoder Reranker Configuration
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=true

# Ingestion & Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Configuration
TOP_K=5
RRF_K=60
INDEX_DIR=data/indices

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
